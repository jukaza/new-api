# Cổng chạy ứng dụng (Port)
# PORT=3000
# URL cơ sở của Frontend (Frontend Base URL)
# FRONTEND_BASE_URL=https://your-frontend-url.com


# Cấu hình gỡ lỗi (Debug)
# Bật pprof (Công cụ phân tích hiệu suất)
# ENABLE_PPROF=true
# Bật chế độ Debug
# DEBUG=true
# Cấu hình Pyroscope
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# Cấu hình cơ sở dữ liệu (Database)
# Bật ghi log lỗi (Error Log)
# ERROR_LOG_ENABLED=true
# Chuỗi kết nối Database (DSN)
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# Chuỗi kết nối Database cho Log
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# Đường dẫn file SQLite
# SQLITE_PATH=/path/to/sqlite.db
# Số kết nối nhàn rỗi tối đa (Max Idle Conns)
# SQL_MAX_IDLE_CONNS=100
# Số kết nối mở tối đa (Max Open Conns)
# SQL_MAX_OPEN_CONNS=1000
# Thời gian sống tối đa của kết nối tính bằng giây (Max Lifetime)
# SQL_MAX_LIFETIME=60


# Cấu hình bộ nhớ đệm (Cache)
# Chuỗi kết nối Redis
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# Tần suất đồng bộ tính bằng giây (Sync Frequency)
# SYNC_FREQUENCY=60
# Bật bộ nhớ đệm trong RAM (Memory Cache)
# MEMORY_CACHE_ENABLED=true
# Tần suất cập nhật Kênh (Channel) tính bằng giây
# CHANNEL_UPDATE_FREQUENCY=30
# Bật cập nhật hàng loạt (Batch Update)
# BATCH_UPDATE_ENABLED=true
# Khoảng thời gian cập nhật hàng loạt tính bằng giây
# BATCH_UPDATE_INTERVAL=5

# Cấu hình Nhiệm vụ (Task) và Chức năng
# Bật Nhiệm vụ cập nhật
# UPDATE_TASK=true

# Cấu hình thời gian chờ (Timeout)
# Thời gian chờ cho tất cả các Request (giây), mặc định 0 là không giới hạn
# RELAY_TIMEOUT=0
# Thời gian chờ phản hồi của luồng stream (giây), nếu nhận kết quả rỗng có thể thử tăng lên
# STREAMING_TIMEOUT=300

# Thiết lập bỏ qua xác thực TLS / HTTP
# TLS_INSECURE_SKIP_VERIFY=false

# Số lượng ảnh tối đa cho Gemini Vision
# GEMINI_VISION_MAX_IMAGE_NUM=16

# Khóa bí mật của Phiên làm việc (Session Secret)
# SESSION_SECRET=random_string

# Các cấu hình khác
# Tạo Token mặc định
# GENERATE_DEFAULT_TOKEN=false
# Thiết lập an toàn cho Cohere (Safety Setting)
# COHERE_SAFETY_SETTING=NONE
# Bật tính năng đếm Token của hình ảnh
# GET_MEDIA_TOKEN=true
# Bật tính năng đếm Token của hình ảnh cho chế độ không stream (stream=false)
# GET_MEDIA_TOKEN_NOT_STREAM=false
# Cho phép kênh Dify xuất thông tin Workflow và Node cho Client
# DIFY_DEBUG=true

# Cấu hình liên quan đến LinuxDo
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# Loại Node (Cụm máy chủ)
# Nếu là node chính (master node) thì điền 'master'
# NODE_TYPE=master

# Danh sách các Domain Redirect đáng tin cậy (ngăn cách bằng dấu phẩy, hỗ trợ subdomain)
# Dùng để xác thực an toàn URL callback thanh toán thành công / hủy bỏ
# Ví dụ: example.com,myapp.io sẽ cho phép example.com, sub.example.com, myapp.io v.v.
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
